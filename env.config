# CoreLedger-X Runtime Configurations
SYSTEM_PORT_INBOUND=8080
UI_PORT_FORWARD=3000

# Cryptographic Module Variables (Piped directly to Rust/Assembly registers)
X86_SECRET_MASK=0xAA55AA55AA55AA55
ROTATION_OFFSET_BITS=13

# Machine Learning Threshold Profiles
AI_CONTAMINATION_RATE=0.01
LOG_MONITOR_TARGET=/var/ledger/storage/ledger_audit.log
